# Database
DATABASE_URL=sqlite+aiosqlite:///./data/agenttrace.db
DATABASE_TYPE=sqlite

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:3000
AUTH_REQUIRED=false

# Realtime and retention
REALTIME_BACKEND=memory
# REDIS_URL=redis://localhost:6379/0

# Deterministic trace sampling
TRACE_SAMPLING_MODE=off
TRACE_SAMPLE_RATE=1.0
# TRACE_TAIL_SLOW_MS=5000
TRACE_TAIL_KEEP_ERRORS=true

# Trace retention
MAX_TRACE_RETENTION_DAYS=30

# SDK exporter
BUFFER_SIZE=100

# LLM provider keys (only needed for real mode)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Hybrid client mode: sim (default, no API key needed) or real
AGENTTRACE_LLM_MODE=sim
AGENTTRACE_LLM_SEED=42

# Docker Compose overrides
# DATABASE_URL=postgresql+asyncpg://agenttrace:agenttrace@db:5432/agenttrace
# DATABASE_TYPE=postgres
